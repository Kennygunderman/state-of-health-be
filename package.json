  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma": "prisma",
    "check:test-db": "ts-node --project tsconfig.test.json src/__tests__/setup/testDb.ts",
    "pretest": "npm run check:test-db",
    "test": "jest --ci --runInBand --coverage",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "catalog:import": "ts-node --project tsconfig.scripts.json scripts/catalog-import-usda.ts",
    "catalog:generate": "ts-node --project tsconfig.scripts.json scripts/catalog-generate-ai.ts",
    "catalog:validate": "ts-node --project tsconfig.scripts.json scripts/catalog-validate.ts",
    "catalog:report": "ts-node --project tsconfig.scripts.json scripts/catalog-report.ts",
    "catalog:release": "ts-node --project tsconfig.scripts.json scripts/catalog-release.ts",
    "catalog:load": "ts-node --project tsconfig.scripts.json scripts/catalog-load.ts",
    "recipes:seed": "ts-node --project tsconfig.scripts.json scripts/recipes-seed.ts",
    "search:benchmark": "ts-node --project tsconfig.scripts.json scripts/search-benchmark.ts",
    "db:seed:dev": "ts-node --project tsconfig.scripts.json scripts/seed-dev.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "date-fns": "^4.1.0",
