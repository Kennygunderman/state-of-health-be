    "express": "^4.18.2",
    "firebase-admin": "^13.4.0",
    "pg": "^8.16.0",
    "prisma": "6.9.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.0",
    "@types/supertest": "7.2.1",
    "@types/uuid": "^9.0.8",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
