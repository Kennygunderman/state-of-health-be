# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/state_of_health

# USDA FoodData Central. usda.service throws if this is unset — food search
# and AI grounding both fail without it. https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=

# OpenRouter, used by both AI endpoints (/macros/estimate, /macros/label-scan)
OPENROUTER_API_KEY=

# Base64 of the Firebase service account JSON. Optional locally — dev falls
# back to ./serviceAccountKey.json. Required in deployed environments:
#   base64 -i serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# USDA_API_KEY and OPENROUTER_API_KEY keep their existing runtime roles —
# /api/macros/estimate and /api/macros/label-scan call OpenRouter,
# /api/macros/search-branded-foods calls USDA — and are additionally required
# by the offline catalog scripts below. Once the catalog is seeded, plan
# generation, swaps, grocery aggregation, recipe viewing and internal catalog
# search make no live USDA or model calls.

# ---------------------------------------------------------------------------
# Development runtime and feature controls — active values, because a local
# checkout wants them set rather than discovered. Every one still has a working
# default in code, so deleting a line degrades to that default rather than
# failing; the comment on each says what the default is.
# ---------------------------------------------------------------------------

# Development values. Production sets NODE_ENV to production through the image
# (Dockerfile) and CI sets it to test; PORT is optional either way because
# src/server.ts already falls back to 3000.
NODE_ENV=development
PORT=3000

# Meal-planning server kill switch: off unless the value is exactly "true", so
# absent, blank or misspelled all mean off (the inverse of AI_FEATURES_ENABLED,
# which disables only on exactly "false"). Production turns it on only after
# the catalog, recipes and search benchmark have been loaded and verified.
# Gates /meal-planning/* and /recipes/* but never /meal-planning/targets* or
# /catalog/*, so Account, Diary and Progress keep reading and writing targets
# while planning is off.
MEAL_PLANNING_ENABLED=false

# Fault injection for reaching the failure states in development and test:
# off | generation | swap | log. Never set it in production — it is forced to
# "off" whenever NODE_ENV is production, so a stray value cannot take the
# service down, and an unrecognised value fails startup everywhere else.
MEAL_PLANNING_FAULT=off

# Catalog pipeline. Read only by the offline catalog and recipe seed scripts,
# never on a request path.

# Models for catalog generation and its advisory review pass. Leave blank to
# inherit OPENROUTER_MODEL and ESTIMATE_JUDGE_MODEL respectively — both are in
# the Optional section below, with the default each falls back to.
CATALOG_GENERATION_MODEL=
CATALOG_REVIEW_MODEL=

# USDA FoodData Central allows 1,000 requests per hour per key. 900 leaves 100
# per hour of headroom for the running API's estimate and branded-search
# traffic on the same key; the import pauses when the bucket empties rather
# than failing.
USDA_IMPORT_RATE_LIMIT_PER_HOUR=900

# Candidates per generation batch.
CATALOG_BATCH_SIZE=25

# Required positive integer: the hard cap on OpenRouter calls for one
# catalog:generate or catalog:validate run, shared by the generation and the
# review call. The scripts fail closed at startup when it is missing,
# non-numeric, zero or negative, and reserve a call before spending it, so a
# failed call still consumes its reservation.
CATALOG_MODEL_CALL_BUDGET=1500

# Total timeout for one identity-evidence fetch.
EVIDENCE_FETCH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Optional — every value below has a working default; listed so the knobs are
# discoverable. Uncomment only to override.
#
# PORT appears twice on purpose: as the commented reference entry below, and as
# an active development value in the block above. The active assignment is the
# one a copied .env uses; src/server.ts still falls back to 3000 when neither
# is present.
# ---------------------------------------------------------------------------

# Port the server listens on.
# PORT=3000

# USDA API root.
# USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1

# Model used to estimate food items from text/photo input.
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Model used by the USDA grounding judge (a classification task, so it gets its
# own model rather than reusing OPENROUTER_MODEL).
# ESTIMATE_JUDGE_MODEL=openai/gpt-4o-mini

# Set to exactly "off" to skip USDA grounding and return raw model estimates.
# Any other value (or unset) leaves grounding enabled.
# ESTIMATE_GROUNDING=off

# Kill switch. Set to exactly "false" to reject all AI calls, authoritative
# even against callers holding a valid token. Any other value leaves AI on.
# AI_FEATURES_ENABLED=false

# Free AI calls per user per UTC day, shared by estimate and label-scan.
# AI_DAILY_QUOTA=5

# Comma-separated emails exempt from the daily quota.
# AI_UNLIMITED_EMAILS=

# GIT_SHA is not set here — the Dockerfile injects it from the SOURCE_COMMIT
# build arg and /health reports it.

# Deliberately not a key here: SHADOW_DATABASE_URL, needed only by
# prisma migrate dev --create-only and prisma migrate diff. Both reset the
# database they point at, and a test run truncates its own, so give
# development, test and shadow three separate local databases and never point
# any of them at data you want to keep.

# The test suite's truncate authorisation, and the reason it is a variable
# rather than something the suite decides for itself: src/__tests__/setup
# empties the meal-planning tables plus meal_entries, meals and users
# (CASCADE) between suites, and nothing should be able to do that to a database
# by accident. The guard refuses to run at all unless all three of these hold:
# NODE_ENV is exactly "test", ALLOW_DB_TRUNCATE is exactly "true" ("TRUE", "1"
# and a blank value are refused), and DATABASE_URL names a database whose name
# ends in _test — optionally with a clone index, as in soh_test_46 — or is
# exactly "ci", on localhost, 127.0.0.1 or postgres. The name rule holds
# regardless of the other two: setting this variable can never authorise a
# truncate of a development, shadow or production database, and a _test name on
# a remote host is refused as well. Never set it in a shell that points at data
# anyone wants to keep.
#
# The key below is deliberately left commented, and not because an active value
# would be dangerous — the name rule above means this acknowledgement can never
# authorise a development, shadow or production database on its own. It is
# commented because putting it in .env would not work: the guard runs as Jest's
# first setup statement and reads the process environment directly, and nothing
# in the test harness loads this file, so a value written here is never seen by
# npm test. It belongs in the environment of the command itself:
#
#   NODE_ENV=test ALLOW_DB_TRUNCATE=true \
#     DATABASE_URL=postgresql://user:password@localhost:5432/state_of_health_test \
#     npm test
#
# CI does exactly that, as job-level environment (see .github/workflows/ci.yml)
# against its own throwaway "ci" database.
# ALLOW_DB_TRUNCATE=true
