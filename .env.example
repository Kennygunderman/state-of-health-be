# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/state_of_health

# USDA FoodData Central
USDA_API_KEY=

# OpenRouter (AI endpoints)
OPENROUTER_API_KEY=

# Base64 of the Firebase service account JSON. Optional locally — dev falls
# back to ./serviceAccountKey.json. Required in deployed environments:
#   base64 -i serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# USDA_API_KEY and OPENROUTER_API_KEY keep their existing runtime roles —
# /api/macros/estimate and /api/macros/label-scan call OpenRouter,
# /api/macros/search-branded-foods calls USDA — and are additionally required
# by the offline catalog scripts below. Once the catalog is seeded, plan
# generation, swaps, grocery aggregation, recipe viewing and internal catalog
# search make no live USDA or model calls.

# Development values. Production sets NODE_ENV to production through the image
# (Dockerfile) and CI sets it to test; PORT is optional either way because
# src/server.ts already falls back to 3000.
NODE_ENV=development
PORT=3000

# Meal-planning server kill switch: off unless the value is exactly "true", so
# absent, blank or misspelled all mean off (the inverse of AI_FEATURES_ENABLED,
# which disables only on exactly "false"). Production turns it on only after
# the catalog, recipes and search benchmark have been loaded and verified.
# Gates /meal-planning/* and /recipes/* but never /meal-planning/targets* or
# /catalog/*, so Account, Diary and Progress keep reading and writing targets
# while planning is off.
MEAL_PLANNING_ENABLED=false

# Fault injection for reaching the failure states in development and test:
# off | generation | swap | log. Never set it in production — it is forced to
# "off" whenever NODE_ENV is production, so a stray value cannot take the
# service down, and an unrecognised value fails startup everywhere else.
MEAL_PLANNING_FAULT=off

# Catalog pipeline. Read only by the offline catalog and recipe seed scripts,
# never on a request path.

# Models for catalog generation and its advisory review pass. Leave blank to
# inherit OPENROUTER_MODEL and ESTIMATE_JUDGE_MODEL respectively.
CATALOG_GENERATION_MODEL=
CATALOG_REVIEW_MODEL=

# USDA FoodData Central allows 1,000 requests per hour per key. 900 leaves 100
# per hour of headroom for the running API's estimate and branded-search
# traffic on the same key; the import pauses when the bucket empties rather
# than failing.
USDA_IMPORT_RATE_LIMIT_PER_HOUR=900

# Candidates per generation batch.
CATALOG_BATCH_SIZE=25

# Required positive integer: the hard cap on OpenRouter calls for one
# catalog:generate or catalog:validate run, shared by the generation and the
# review call. The scripts fail closed at startup when it is missing,
# non-numeric, zero or negative, and reserve a call before spending it, so a
# failed call still consumes its reservation.
CATALOG_MODEL_CALL_BUDGET=1500

# Total timeout for one identity-evidence fetch.
EVIDENCE_FETCH_TIMEOUT_MS=10000

# Deliberately not a key here: SHADOW_DATABASE_URL, needed only by
# prisma migrate dev --create-only and prisma migrate diff. Both reset the
# database they point at, and a test run truncates its own, so give
# development, test and shadow three separate local databases and never point
# any of them at data you want to keep.
