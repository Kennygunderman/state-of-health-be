generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model daily_exercises {
  id             String          @id(map: "daily_exercise_pkey") @db.Uuid
  workout_day_id String          @db.Uuid
  exercise_id    String          @db.Uuid
  order          Int?            @default(0)
  user_exercises user_exercises  @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "daily_exercise_exercise_id_fkey")
  workout_days   workout_days    @relation(fields: [workout_day_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "daily_exercise_workout_day_id_fkey")
  exercise_sets  exercise_sets[]

  @@index([exercise_id], map: "idx_daily_exercises_exercise_id")
}

model exercise_sets {
  id                String          @id(map: "exercise_set_pkey") @db.Uuid
  daily_exercise_id String          @db.Uuid
  reps              Int?
  weight            Float?
  added_weight      Float?
  duration_seconds  Int?
  distance_meters   Float?
  rpe               Float?
  is_warmup         Boolean?        @default(false)
  completed         Boolean?        @default(false)
  set_number        Int?
  completed_at      DateTime?       @db.Date
  daily_exercises   daily_exercises @relation(fields: [daily_exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "exercise_set_daily_exercise_id_fkey")
}

model user_exercises {
  id                 String             @id(map: "exercise_pkey") @db.Uuid
  name               String
  exercise_type      String
  exercise_body_part String
  logging_type       String             @default("WEIGHT_REPS")
  user_id            String?
  deleted_at         DateTime?          @db.Timestamptz(6)
  daily_exercises    daily_exercises[]
  personal_records   personal_records[]
  users              users?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_exercise_user_id_fkey")

  @@index([user_id], map: "idx_user_exercises_user_id")
}

model users {
  id                    String                 @id
  first_name            String?
  last_name             String?
  email                 String                 @unique
  // Daily macro targets. Nullable = "not set"; the app falls back to its
  // local default (1800 cal) until the user saves targets.
  target_calories       Int?
  target_protein_g      Int?
  target_carbs_g        Int?
  target_fat_g          Int?
  // Base64 JPEG, client-resized to ~192px (~10-20KB) — small enough to live
  // in the row instead of object storage.
  avatar_base64         String?
  templates             templates[]
  user_exercises        user_exercises[]
  personal_records      personal_records[]
  runs                  runs[]
  run_personal_records  run_personal_records[]
  body_weight_entries   body_weight_entries[]
  foods                 foods[]
  meals                 meals[]
  meal_entries          meal_entries[]
  meal_plan_preferences meal_plan_preferences?
  meal_plans            meal_plans[]
  meal_plan_days        meal_plan_days[]
  meal_plan_meals       meal_plan_meals[]
  grocery_items         grocery_items[]
  meal_plan_actions     meal_plan_actions[]
}

model workout_days {
  id              String            @id(map: "workout_day_pkey") @db.Uuid
  user_id         String
  date            DateTime          @db.Date
  has_synced      Boolean?          @default(false)
  updated_at      BigInt            @default(0)
  daily_exercises daily_exercises[]

  @@unique([user_id, date], map: "unique_user_date")
}

model templates {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String
  name         String
  tagline      String
  exercise_ids String[]
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, name], map: "unique_user_template_name")
  @@index([user_id], map: "idx_templates_user_id")
}

// Current-best PR per user x exercise x record type. record_type is one of:
// MAX_WEIGHT | MAX_REPS | MAX_ESTIMATED_1RM | MAX_VOLUME | MAX_DURATION | MAX_DISTANCE
model personal_records {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String
  exercise_id     String         @db.Uuid
  record_type     String
  value           Float
  unit            String
  reps_at_record  Int?
  exercise_set_id String?        @db.Uuid
  achieved_at     DateTime
  created_at      DateTime       @default(now())
  users           users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_exercises  user_exercises @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, exercise_id, record_type], map: "unique_user_exercise_record_type")
  @@index([user_id], map: "idx_personal_records_user_id")
}

// Cardio session, sibling to workout_days rather than nested inside it.
// has_synced / updated_at mirror workout_days' offline-sync contract exactly.
model runs {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String
  started_at           DateTime
  ended_at             DateTime?
  duration_seconds     Int
  distance_meters      Float
  avg_pace_sec_per_km  Float?
  elevation_gain_m     Float?
  elevation_loss_m     Float?
  avg_heart_rate       Int?
  max_heart_rate       Int?
  calories             Int?
  run_type             String                 @default("OUTDOOR")
  source               String                 @default("MANUAL")
  route_polyline       String?                @db.Text
  notes                String?
  has_synced           Boolean?               @default(false)
  updated_at           BigInt                 @default(0)
  created_at           DateTime               @default(now())
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  run_splits           run_splits[]
  run_personal_records run_personal_records[]

  @@index([user_id, started_at], map: "idx_runs_user_id_started_at")
}

// One row per weigh-in. logged_at is a full timestamp (not a date) so the app
// can show time-of-day context ("morning") and allow multiple entries per day.
model body_weight_entries {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String
  weight     Float
  logged_at  DateTime
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, logged_at], map: "idx_body_weight_entries_user_id_logged_at")
}

model run_splits {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id           String @db.Uuid
  split_number     Int
  distance_meters  Float
  duration_seconds Int
  pace_sec_per_km  Float?
  runs             runs   @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([run_id, split_number], map: "unique_run_split_number")
}

// Separate from personal_records (rather than a nullable exercise_id there) because
// Postgres unique indexes treat NULL as distinct from NULL, so a nullable exercise_id
// would let duplicate run PR rows slip past the uniqueness guarantee. record_type here
// is one of: MAX_DISTANCE | MAX_DURATION | BEST_PACE
model run_personal_records {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String
  record_type String
  value       Float
  unit        String
  run_id      String?  @db.Uuid
  achieved_at DateTime
  created_at  DateTime @default(now())
  users       users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  runs        runs?    @relation(fields: [run_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([user_id, record_type], map: "unique_user_run_record_type")
}

// ---------------------------------------------------------------------------
// Macros (nutrition) — see ../macros-refactor-plan/ in the workspace root.
// ---------------------------------------------------------------------------

// Personal food library ("Your foods"). One row per user-owned food with
// per-serving values. Soft-deleted so meal_entries snapshots keep provenance.
model foods {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String
  name           String
  serving_amount Float          @default(1)
  serving_unit   String?
  calories       Int
  protein_g      Int
  carbs_g        Int
  fat_g          Int
  brand          String?
  source         String         @default("manual") // 'manual' | 'label_scan' | 'branded' | 'seed'
  created_at     DateTime       @default(now())
  updated_at     DateTime       @default(now()) @updatedAt
  deleted_at     DateTime?      @db.Timestamptz(6)
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meal_entries   meal_entries[]

  @@index([user_id, name], map: "idx_foods_user_id_name")
}

// One row per meal per user-day (Breakfast/Lunch/Dinner defaults are created
// lazily on first read of a day; users can add/rename/delete custom meals).
model meals {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String
  date         DateTime       @db.Date
  name         String
  sort_order   Int            @default(0)
  created_at   DateTime       @default(now())
  deleted_at   DateTime?      @db.Timestamptz(6)
  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meal_entries meal_entries[]

  @@index([user_id, date], map: "idx_meals_user_id_date")
}

// One row per logged item inside a meal. Name/serving/macros are SNAPSHOTS
// taken at log time (per-serving values); displayed totals multiply by
// `servings` at read time. food_id is provenance only — renders never join
// through it, so library edits/deletes can't rewrite history.
model meal_entries {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meal_id                  String              @db.Uuid
  user_id                  String // denormalized for cheap day/history aggregates
  date                     DateTime            @db.Date // denormalized day key, matches meals.date
  food_id                  String?             @db.Uuid
  name                     String
  serving_text             String?
  servings                 Float               @default(1)
  calories                 Int // per serving (as-eaten for AI items, servings = 1)
  protein_g                Int // per serving
  carbs_g                  Int
  fat_g                    Int
  input_method             String              @default("library") // 'library' | 'search' | 'ai_text' | 'ai_photo' | 'meal_plan'
  raw_input                String?             @db.Text
  logged_at                DateTime            @default(now())
  updated_at               DateTime            @default(now()) @updatedAt
  deleted_at               DateTime?           @db.Timestamptz(6)
  // Meal-planning provenance, all nullable: rows predating the feature and
  // hand-logged entries carry none, and a NULL nutrition_provenance reads as
  // "unknown / user-entered" rather than as a verified source.
  meal_plan_meal_id        String?             @db.Uuid
  catalog_food_id          String?             @db.Uuid
  recipe_version_id        String?             @db.Uuid
  nutrition_provenance     String? // 'source_backed' | 'ingredient_derived' | 'ai_estimated' | 'user_entered'
  meals                    meals               @relation(fields: [meal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                    users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  foods                    foods?              @relation(fields: [food_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  meal_plan_meals          meal_plan_meals?    @relation("meal_entries_planned_meal", fields: [meal_plan_meal_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  catalog_foods            catalog_foods?      @relation(fields: [catalog_food_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recipe_versions          recipe_versions?    @relation(fields: [recipe_version_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Tenant guard beside the SET NULL link above: the pair (meal_plan_meal_id,
  // user_id) must name a planned meal of the SAME user, so a diary entry can
  // never be linked to another user's planned meal. MATCH SIMPLE leaves the pair
  // unchecked while meal_plan_meal_id IS NULL, and NO ACTION (not Restrict) lets
  // the SET NULL above clear the link first when a planned meal is deleted.
  tenant_meal_plan_meals   meal_plan_meals?    @relation("meal_entries_planned_meal_tenant", fields: [meal_plan_meal_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction)
  meal_plan_actions        meal_plan_actions[] @relation("meal_plan_actions_entry")
  tenant_meal_plan_actions meal_plan_actions[] @relation("meal_plan_actions_entry_tenant")

  // Composite candidate key: the referenced side of every (link, user_id) tenant
  // foreign key that points at a diary entry. id is already unique, so this adds
  // no new restriction on the rows — only the key those guards need.
  @@unique([id, user_id])
  @@index([user_id, date], map: "idx_meal_entries_user_id_date")
  @@index([meal_id], map: "idx_meal_entries_meal_id")
  // Recipe-version visibility: GET /recipes/:id admits a retired version the
  // caller has a diary entry for, which is a lookup by recipe_version_id.
  @@index([recipe_version_id], map: "idx_meal_entries_recipe_version_id")
}

// Raw USDA responses keyed by normalized request (path + params). USDA data
// is public domain with no retention restrictions; stale rows are served
// immediately and refreshed in the background — see usda.service.
model usda_api_cache {
  cache_key  String   @id(map: "usda_api_cache_pkey")
  payload    Json
  fetched_at DateTime @default(now()) @db.Timestamptz(6)
}

// One row per user x UTC day, counting AI calls (estimate + label-scan share
// the pool). Enforces the free daily quota — see entitlement.service.
model ai_usage {
  user_id    String
  day        String // 'YYYY-MM-DD' (UTC)
  count      Int      @default(0)
  updated_at DateTime @default(now()) @updatedAt

  @@id([user_id, day], map: "ai_usage_pkey")
}

// ---------------------------------------------------------------------------
// Meal planning — internal food catalog, recipes, preferences, weekly plans,
// grocery lists. Every closed value set below is a plain TEXT column validated
// by the domain's pure *.logic.ts parser, which throws a typed error the
// controller maps to 400: a database CHECK would surface as an untyped Prisma
// error instead and would move the rule out of the pure layer. The permitted
// values are therefore documented inline, as input_method and foods.source
// already are.
// ---------------------------------------------------------------------------

// The catalog and recipe tables are the one deliberate exception to the
// user-scoped query rule: they hold shared reference data, carry no user_id,
// and are the only authenticated reads without a tenant predicate. Adding an
// owner column here would be a mistake, not a fix.

// One row per pipeline run. cursor is the resume checkpoint, so an interrupted
// import continues where it stopped instead of restarting; the newest
// succeeded 'release_load' run is what GET /catalog/status reports as the
// active catalog release.
model catalog_import_runs {
  id                         String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                       String // 'usda_import' | 'ai_generation' | 'validation' | 'release' | 'release_load'
  manifest_version           String
  started_at                 DateTime                     @default(now())
  finished_at                DateTime?
  status                     String // 'running' | 'succeeded' | 'failed'
  cursor                     Json?
  counts                     Json?
  log                        Json?
  catalog_generation_batches catalog_generation_batches[]

  @@index([kind, started_at])
}

// One AI generation batch, keyed '<coveragePlanVersion>:<category>:<batchIndex>'
// so a rerun addresses exactly the same batches. model_calls_reserved is
// incremented BEFORE each paid model call and model_calls_used only after it
// returns: a failed call still costs tokens, so the two counters must never be
// collapsed into one or the budget stops being enforceable.
//
// batch_key is unique ACROSS THE TABLE, not per run, and that constraint is
// load-bearing rather than incidental: the spend cap is enforced as
// SUM(model_calls_reserved) over one run's rows, so a batch's paid calls can only
// ever be metered for the single run that owns its row. What makes that coherent
// is the run lifecycle in scripts/lib/checkpoint.ts, and the two must be read
// together — openOrResumeRun never opens a competing run over work an earlier run
// already owns: a stage interrupted mid-flight resumes its own running row, a
// stage that was closed as 'failed' is retried by continuing that same row (its
// spent budget is not forgiven and its batch keys stay addressable), and a stage
// already closed as 'succeeded' is reported complete without a write. Genuinely
// new generation work therefore means a new coveragePlanVersion, which yields
// batch keys of its own. Catalog data idempotency is separate again and lives in
// the pipeline's own upserts (source_key for foods, slug for recipes).
model catalog_generation_batches {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id               String              @db.Uuid
  batch_key            String
  category             String
  model                String
  prompt_version       String
  status               String // 'pending' | 'generated' | 'validated' | 'failed'
  candidate_count      Int                 @default(0)
  accepted_count       Int                 @default(0)
  model_calls_reserved Int                 @default(0)
  model_calls_used     Int                 @default(0)
  tokens_used          Int                 @default(0)
  catalog_import_runs  catalog_import_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalog_foods        catalog_foods[]

  @@unique([batch_key])
}

// The internal food catalog. Identity (identity_source / identity_status),
// nutrition provenance (nutrition_provenance) and publication
// (publication_status) are three INDEPENDENT columns, never one mixed enum: a
// USDA-sourced row can still be quarantined, and an AI-estimated row can be
// published for search while never qualifying as recipe-eligible. Nutrition is
// versioned separately from metadata so a nutrient change and a name/allergen
// change each invalidate a recipe snapshot on their own. A NULL nutrient means
// UNKNOWN and is never coerced to 0.
model catalog_foods {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Deterministic and portable — 'usda:<fdcId>' or
  // 'ai:<coverage_category>:<normalized canonical_name>:<food_state>'. This is
  // the key every import, generation and release load upserts on, which is what
  // makes a rerun a no-op and a release loadable into any database.
  source_key                 String
  canonical_name             String
  display_name               String
  category                   String // the 21-value coverage-plan list: produce_vegetable … other
  food_state                 String // 'raw' | 'cooked' | 'prepared' | 'dry' | 'as_purchased'
  identity_source            String // 'usda' | 'ai_generated'
  identity_status            String // 'verified' | 'ambiguous' | 'unsourced'
  nutrition_provenance       String // 'source_backed' | 'ingredient_derived' | 'ai_estimated'
  nutrition_version          Int
  metadata_version           Int
  nutrition_basis            String // 'per_100g' | 'per_100ml' | 'per_serving'
  basis_amount               Float
  calories                   Float?
  protein_g                  Float?
  carbs_g                    Float?
  fat_g                      Float?
  fiber_g                    Float?
  density_g_per_ml           Float?
  usda_fdc_id                Int?
  usda_data_type             String?
  usda_description           String?
  source_version             String?
  source_cache_key           String?
  generation_batch_id        String?                     @db.Uuid
  // 'retired' is set only by catalog-load, for a previously published food that
  // a newer release no longer contains: retired rows stay referenceable by
  // recipe_ingredients and meal_entries, but are excluded from search,
  // suggestions and new recipe eligibility.
  publication_status         String // 'candidate' | 'published' | 'quarantined' | 'rejected' | 'retired'
  // Required lists. Prisma cannot emit NOT NULL for a scalar list, so the
  // migration SQL adds it by hand - and `prisma migrate diff` does not report
  // it, so what holds the operator copy of the migration to it is the
  // ledger-equivalence gate rather than the committed schema-diff evidence;
  // @default([]) keeps the datamodel and the database agreed on the default, so
  // an omitted list is stored as the empty set it means and never as SQL NULL.
  allergen_tags              String[]                    @default([])
  allergen_status            String // 'known' | 'unknown'
  diet_tags                  String[]                    @default([])
  food_group                 String // controlled taxonomy from the coverage plan; a dislike stores the food id and this group
  is_common_dislike          Boolean                     @default(false)
  cost_class                 Int                         @db.SmallInt
  search_text                String?
  // The STORED generated expression is appended by hand in the migration SQL
  // because Prisma cannot express it, and the generated client omits Unsupported
  // fields, so this stays optional to keep create() calls compiling. The GIN
  // index over it is declarable and is declared below.
  search_vector              Unsupported("tsvector")?
  imported_at                DateTime?
  created_at                 DateTime                    @default(now())
  updated_at                 DateTime                    @default(now()) @updatedAt
  catalog_generation_batches catalog_generation_batches? @relation(fields: [generation_batch_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  catalog_food_aliases       catalog_food_aliases[]
  catalog_food_portions      catalog_food_portions[]
  catalog_food_components    catalog_food_components[]   @relation("catalog_food_components_food")
  component_usages           catalog_food_components[]   @relation("catalog_food_components_component")
  catalog_validation_records catalog_validation_records?
  recipe_ingredients         recipe_ingredients[]
  grocery_items              grocery_items[]
  meal_entries               meal_entries[]

  @@unique([source_key])
  @@unique([usda_fdc_id])
  @@index([publication_status, category])
  @@index([food_group])
  // GET /catalog/foods/suggestions?kind=dislike reads published foods flagged as
  // a common dislike; without a flag-leading index that is a scan of the whole
  // published catalog.
  @@index([is_common_dislike, publication_status])
  // Mirrors the GIN index the migration creates by hand, so the schema-diff gate
  // does not read it as drift. map: pins the migration's index name.
  @@index([search_vector(ops: raw("tsvector_ops"))], map: "idx_catalog_foods_search_vector", type: Gin)
}

// Search aliases. One alias hit must never produce a duplicate search row,
// which is why search aggregates to one row per food rather than joining these
// out.
//
// The lower(alias) expression index is appended in the migration SQL, which
// Prisma cannot express either as an expression or with its operator class, and
// the operator class is load-bearing: the index is declared
// `lower("alias") text_pattern_ops` because its only caller's predicate is a
// left-anchored `lower(alias) LIKE 'x%'`, and a btree derives LIKE range bounds
// only under a `*_pattern_ops` class or a C column collation — which the
// en_US.utf8 databases this project creates do not have. With the default
// `text_ops` the planner refuses the index outright, so this is a correctness
// property of the index rather than a tuning preference. Equality is still
// served, so the class replaces `text_ops` rather than joining it.
// Unlike idx_catalog_foods_search_vector above, no @@index can mirror this one,
// so the schema-diff gate is blind to it by design and
// docs/meal-planning/expected-schema-diff.sql reads the class back out of
// pg_opclass instead.
model catalog_food_aliases {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog_food_id String        @db.Uuid
  alias           String
  catalog_foods   catalog_foods @relation(fields: [catalog_food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([catalog_food_id, alias])
}

// Portion -> gram conversions, the only way a recipe or grocery quantity leaves
// the per-100g basis. gram_weight must be > 0 and exactly one portion per food
// may be the default; catalog.logic.ts enforces both, and the default is also
// backed by a partial unique index appended in the migration SQL.
model catalog_food_portions {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog_food_id String        @db.Uuid
  description     String
  amount          Float
  unit            String
  gram_weight     Float
  is_default      Boolean       @default(false)
  source          String
  catalog_foods   catalog_foods @relation(fields: [catalog_food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([catalog_food_id, description])
}

// The typed composition of an ingredient-derived food, so catalog.logic.ts can
// recompute its nutrition deterministically instead of storing an opinion. The
// component side is Restrict: a food that another food is built from gets
// retired, never deleted.
model catalog_food_components {
  id                          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog_food_id             String        @db.Uuid
  component_catalog_food_id   String        @db.Uuid
  quantity_grams              Float
  yield_factor                Float // cooked/raw mass change applied to this component
  component_nutrition_version Int
  sort_order                  Int
  catalog_foods               catalog_foods @relation("catalog_food_components_food", fields: [catalog_food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  component_catalog_foods     catalog_foods @relation("catalog_food_components_component", fields: [component_catalog_food_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([catalog_food_id, component_catalog_food_id])
}

// The machine-readable validation record every published food must have — one
// row per food, so the outcome is auditable per item rather than per run. checks
// holds one entry per deterministic check (name, pass, observed, bound);
// llm_review is advisory only and never promotes a value to published.
model catalog_validation_records {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catalog_food_id       String        @unique @db.Uuid
  canonical_identity    Json
  // Required list; NOT NULL is added by hand in the migration SQL (see
  // catalog_foods.allergen_tags) and @default([]) keeps datamodel and database
  // agreed that an omitted alias list is the empty set.
  aliases               String[]      @default([])
  category              String
  food_state            String
  identity_source       String
  identity_status       String
  nutrition_provenance  String
  nutrition_method      String
  nutrition_assumptions String?
  portion_units         Json
  identity_evidence     Json // retrieval records: url, final host, status, body hash, matched snippet, fetched_at
  checks                Json
  llm_review            Json?
  outcome               String // 'accepted' | 'quarantined' | 'rejected'
  reviewed_at           DateTime
  publication_status    String
  source_versions       Json
  history               Json
  catalog_foods         catalog_foods @relation(fields: [catalog_food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// A recipe identity. current_version_id names the single planning-current
// version, which is why the two models reference each other: seeding publishes
// a new recipe_versions row and moves this pointer in one transaction. The
// matching partial unique on recipe_versions (recipe_id) WHERE status =
// 'current' is appended in the migration SQL.
model recipes {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug               String
  current_version_id String?           @db.Uuid
  created_at         DateTime          @default(now())
  current_version    recipe_versions?  @relation("recipes_current_version", fields: [current_version_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recipe_versions    recipe_versions[] @relation("recipe_versions_recipe")

  @@unique([slug])
}

// Immutable once published. A catalog refresh publishes a NEW version and
// retires this one rather than editing it, so every historical plan, recipe
// detail and diary entry keeps the numbers it was actually built from. Retired
// versions stay readable for exactly that reason.
model recipe_versions {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipe_id                String               @db.Uuid
  version                  Int
  name                     String
  description              String?
  icon_key                 String // 'crosshair' | 'fork_knife' | 'bowl' | 'wrap' | 'dome' | 'salad' | 'bowl_dash' | 'pot' | 'cloche'
  instructions             Json
  yield_servings           Float
  serving_description      String
  prep_minutes             Int
  cook_minutes             Int
  total_minutes            Int // prep_minutes + cook_minutes — the value the user's cooking-time limit is applied to
  // No @default([]) on purpose: a version with no slot is never plannable, so an
  // omitted meal_slots must fail the insert rather than be stored as an empty
  // set. NOT NULL is added by hand in the migration SQL, as for every list here.
  meal_slots               String[] // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  diet_tags                String[]             @default([])
  allergen_tags            String[]             @default([])
  allergen_status          String // 'known' | 'unknown' — only 'known' is ever plannable
  budget_tier              Int                  @db.SmallInt
  badges                   String[]             @default([]) // 'high_protein' | 'gluten_free' | 'dairy_free' | 'vegan' | 'quick'
  nutrition_provenance     String // 'source_backed' — planning admits nothing else
  per_serving_calories     Float
  per_serving_protein_g    Float
  per_serving_carbs_g      Float
  per_serving_fat_g        Float
  sourced_calories_note    String?
  status                   String // 'current' | 'retired'
  published_at             DateTime?
  retired_at               DateTime?
  recipes                  recipes              @relation("recipe_versions_recipe", fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  current_of_recipes       recipes[]            @relation("recipes_current_version")
  recipe_ingredients       recipe_ingredients[]
  meal_plan_meals          meal_plan_meals[]    @relation("meal_plan_meals_recipe_version")
  previous_meal_plan_meals meal_plan_meals[]    @relation("meal_plan_meals_previous_recipe_version")
  meal_entries             meal_entries[]

  @@unique([recipe_id, version])
}

// Ingredient quantities plus a SNAPSHOT of the catalog row taken at
// publication: identity, display name, provenance and the allergen/diet safety
// metadata are frozen here, so plan, recipe-detail and diary responses read the
// snapshot and never the live catalog row — a catalog refresh can therefore
// never mutate an existing recipe version. Both version columns are recorded
// because a metadata change (allergen, diet, name, food_group) must invalidate a
// recipe version just as a nutrient change does. USDA FoodData Central is public
// domain, which is what makes snapshot-at-publication storage legal here.
model recipe_ingredients {
  id                        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipe_version_id         String          @db.Uuid
  catalog_food_id           String          @db.Uuid
  catalog_nutrition_version Int
  catalog_metadata_version  Int
  snapshot_per_100g         Json // calories, protein_g, carbs_g, fat_g, fiber_g as stored at version creation
  snapshot_name             String
  snapshot_provenance       String
  snapshot_allergen_tags    String[]        @default([])
  snapshot_diet_tags        String[]        @default([])
  quantity                  Float
  unit                      String
  gram_weight               Float
  display_text              String
  sort_order                Int
  is_optional               Boolean         @default(false)
  recipe_versions           recipe_versions @relation(fields: [recipe_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalog_foods             catalog_foods   @relation(fields: [catalog_food_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([recipe_version_id])
}

// One row per user, created by the first setup step and the source of truth for
// resuming an interrupted setup (setup_status + setup_step survive a restart, a
// React context would not). confirmed_targets mirrors the four users.target_*
// values as they stood at confirmation, which is how the canonical read tells a
// confirmed target from one a legacy PUT /user/targets changed afterwards.
model meal_plan_preferences {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String    @unique
  time_zone                String? // IANA name from the device, refreshed on every step save
  setup_status             String // 'not_started' | 'in_progress' | 'ready_for_review' | 'completed'
  setup_step               String? // 'goal' | 'body' | 'activity' | 'diet' | 'dislikes' | 'schedule' | 'cooking' | 'review' | 'targets_manual'
  review_start_date        DateTime? @db.Date
  target_route             String? // 'estimated' | 'manual'
  goal                     String? // 'lose' | 'maintain' | 'gain'
  goal_weight_kg           Float?
  pace_lb_per_week         Float? // 0.5 | 1 | 1.5
  age                      Int?
  height_cm                Float?
  weight_kg                Float?
  weight_source            String?
  sex_for_estimate         String? // 'female' | 'male' | 'prefer_not_to_say' — the last one takes the manual-target route
  height_unit_pref         String? // 'ft_in' | 'cm'
  weight_unit_pref         String? // 'lb' | 'kg'
  activity_level           String? // 'not_very_active' | 'lightly_active' | 'active' | 'very_active'
  diet                     String? // 'none' | 'vegetarian' | 'vegan' | 'pescatarian'
  allergens                String[]  @default([]) // 'none' is mutually exclusive with the nine named allergens
  // catalog_foods ids held as a plain uuid[]: Postgres cannot foreign-key an
  // array, so membership is validated in preferences.logic.ts instead.
  disliked_food_ids        String[]  @default([]) @db.Uuid
  disliked_food_groups     String[]  @default([])
  meal_schedule            String? // 'three' | 'three_plus_snack'
  meal_times               Json? // one {slot, time} entry per slot of the chosen schedule, in wire order
  cooking_time_limit_min   Int? // 15 | 30 | 45 | 60, total prep + cook per meal
  budget_amount            Int? // whole units of budget_currency
  budget_currency          String? // 'USD' only in this version
  no_budget_preference     Boolean   @default(false)
  budget_tier              Int?      @db.SmallInt
  target_source            String? // 'estimated' | 'manual'
  targets_revision         Int       @default(0)
  confirmed_targets        Json?
  // The `revision` whose goal/body/activity/pace produced the confirmed
  // estimate (AAP 0.5.1). Written only by targets.service.ts, which records the
  // same number the request's estimateRevision pinned; null for manual targets,
  // which have no calculated ancestry.
  targets_input_revision   Int?
  estimated_targets        Json?
  // THE SINGLE INPUT-ANCESTRY COUNTER. `revision` advances on every preference
  // save - diet, allergens, dislikes, schedule, budget, review date, unit
  // preferences, time zone included - and does two jobs: a client pins it to
  // detect a lost update, and comparing it with targets_input_revision is what
  // TargetsResponse.stale means (AAP 0.5.2: stale when source is 'estimated'
  // and targets_input_revision != revision). One counter for both is what makes
  // "confirmed against revision N" and "derived from revision N" the same
  // statement, and it is the revision GET /meal-planning/targets/estimate
  // echoes as estimateRevision.
  revision                 Int       @default(0)
  // A WRITE-SIDE DIAGNOSTIC ONLY, and NOT the basis of TargetsResponse.stale -
  // see `revision` above, which is. This counter advances only when one of the
  // seven answers the energy equation actually reads changes value (goal,
  // pace_lb_per_week, age, height_cm, weight_kg, sex_for_estimate,
  // activity_level - never goal_weight_kg, which the equation never reads), so
  // it records when a user's calculable details last moved, which is a
  // different question from whether a confirmed figure still matches the
  // answers on file. Written by preferences.service.ts through the pure rule
  // targets.logic.ts::estimateInputsChanged and read by no query:
  // TargetsPreferencesRow does not carry it, so the staleness comparison cannot
  // reach it. It is retained rather than dropped because preferences.service.ts
  // still maintains it and the migration's recorded checksum is what the test
  // harness verifies the database against; removing both together is a
  // follow-up in that service, not a change this column can carry alone.
  estimate_inputs_revision Int       @default(0)
  users                    users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

// One published week per user. status and revision drive the write-safety
// model: every mutation takes the per-user advisory lock, requires status =
// 'active', and compares the expected revision before writing. The partial
// unique on (user_id, start_date) WHERE status = 'active' — the backstop that
// makes two overlapping active plans impossible — is appended in the migration
// SQL. targets_snapshot is what this plan was generated against, which is how a
// later target change is reported as stale instead of silently regenerating.
model meal_plans {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                  String
  start_date               DateTime            @db.Date
  end_date                 DateTime            @db.Date
  status                   String // 'active' | 'superseded'
  revision                 Int                 @default(1)
  generation_attempt       Int
  preferences_revision     Int
  targets_revision         Int
  targets_snapshot         Json
  generation_seed          String
  generation_key           String
  replaced_plan_id         String?             @db.Uuid
  incompatibility_flags    Json?
  published_at             DateTime            @default(now())
  users                    users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replaced_plan            meal_plans?         @relation("meal_plans_replaced_plan", fields: [replaced_plan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replaced_by_plans        meal_plans[]        @relation("meal_plans_replaced_plan")
  // Tenant guard beside the SET NULL self-link above: a plan may only supersede
  // a plan of the same user.
  tenant_replaced_plan     meal_plans?         @relation("meal_plans_replaced_plan_tenant", fields: [replaced_plan_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction)
  tenant_replaced_by_plans meal_plans[]        @relation("meal_plans_replaced_plan_tenant")
  meal_plan_days           meal_plan_days[]
  meal_plan_meals          meal_plan_meals[]
  grocery_items            grocery_items[]
  meal_plan_actions        meal_plan_actions[] @relation("meal_plan_actions_plan")
  tenant_meal_plan_actions meal_plan_actions[] @relation("meal_plan_actions_plan_tenant")

  @@unique([user_id, generation_key])
  // Composite candidate key: the referenced side of every (meal_plan_id,
  // user_id) tenant foreign key below, which is what makes a day, meal, grocery
  // item or action of one user structurally unable to reference another user's
  // plan. id is already unique, so no row is newly restricted.
  @@unique([id, user_id])
  @@index([user_id, status, start_date])
}

model meal_plan_days {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meal_plan_id      String            @db.Uuid
  user_id           String // denormalized so every read and write predicate carries the owner without a join
  date              DateTime          @db.Date
  day_index         Int               @db.SmallInt
  planned_calories  Float
  planned_protein_g Float
  planned_carbs_g   Float
  planned_fat_g     Float
  // Tenant-preserving parent reference: the pair (meal_plan_id, user_id) must
  // name a plan of the SAME user, so the denormalized owner column can never
  // disagree with the plan it belongs to. This replaces the single-column plan
  // foreign key rather than sitting beside it — one constraint, both guarantees.
  meal_plans        meal_plans        @relation(fields: [meal_plan_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction)
  users             users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meal_plan_meals   meal_plan_meals[]

  @@unique([meal_plan_id, date])
  // Referenced side of meal_plan_meals' (meal_plan_day_id, user_id) guard.
  @@unique([id, user_id])
  // Leading index for the users cascade: without it, deleting a user scans this
  // table once per row it owns elsewhere.
  @@index([user_id])
}

// One planned slot. meal_plan_id and user_id are denormalized so the composite
// {id, user_id, meal_plan_id} write predicate needs no join and can never match
// a meal whose plan has been superseded. previous_recipe_version_id is an audit
// value only — the card's logged-then-swapped treatment is derived from the
// linked meal_entries, so any number of successive swaps stays representable.
model meal_plan_meals {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meal_plan_day_id           String              @db.Uuid
  meal_plan_id               String              @db.Uuid
  user_id                    String
  slot                       String // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  slot_time                  String // 'HH:mm'
  sort_order                 Int
  recipe_version_id          String              @db.Uuid
  portion_multiplier         Float
  planned_calories           Float
  planned_protein_g          Float
  planned_carbs_g            Float
  planned_fat_g              Float
  revision                   Int                 @default(1)
  // An ARRAY OF {code, detail} OBJECTS — the same shape the DTO's flags carry,
  // so several details per code survive a round trip losslessly. A bare array of
  // codes would lose them.
  flags                      Json                @default("[]")
  previous_recipe_version_id String?             @db.Uuid
  swapped_at                 DateTime?
  // Both parent references are tenant-preserving: (meal_plan_day_id, user_id)
  // and (meal_plan_id, user_id) must each name a row of the SAME user, so the
  // {id, user_id, meal_plan_id} write predicate the planning services use can
  // never match a meal whose day or plan belongs to someone else.
  meal_plan_days             meal_plan_days      @relation(fields: [meal_plan_day_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction)
  meal_plans                 meal_plans          @relation(fields: [meal_plan_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction)
  users                      users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipe_versions            recipe_versions     @relation("meal_plan_meals_recipe_version", fields: [recipe_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  previous_recipe_versions   recipe_versions?    @relation("meal_plan_meals_previous_recipe_version", fields: [previous_recipe_version_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  meal_entries               meal_entries[]      @relation("meal_entries_planned_meal")
  tenant_meal_entries        meal_entries[]      @relation("meal_entries_planned_meal_tenant")
  meal_plan_actions          meal_plan_actions[] @relation("meal_plan_actions_planned_meal")
  tenant_meal_plan_actions   meal_plan_actions[] @relation("meal_plan_actions_planned_meal_tenant")

  @@unique([meal_plan_day_id, slot])
  // Referenced side of the (meal_plan_meal_id, user_id) guards on meal_entries
  // and meal_plan_actions.
  @@unique([id, user_id])
  // Plan-wide reads — affected meals, plan summary, flag recomputation — select
  // every meal of a plan for its owner; the day/slot unique key cannot serve
  // them. Also the referencing side of the plan tenant key above.
  @@index([meal_plan_id, user_id])
  @@index([user_id])
  // Recipe-version visibility and swap history both look meals up by the recipe
  // version they point at, and these are also the RESTRICT / SET NULL foreign
  // keys' referencing columns.
  @@index([recipe_version_id])
  @@index([previous_recipe_version_id])
}

// The weekly list, aggregated from planned portions. The unique key includes
// food_state so raw, dry and cooked quantities of one food never merge into a
// nonsense total. previous_quantity_grams and flagged_at carry the "amount went
// up" flag that keeps an already-checked item checked and visibly changed
// instead of silently folding the increase in.
model grocery_items {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meal_plan_id            String        @db.Uuid
  user_id                 String
  catalog_food_id         String        @db.Uuid
  food_state              String // 'raw' | 'cooked' | 'prepared' | 'dry' | 'as_purchased'
  category                String // 'produce' | 'protein' | 'dairy_alternatives' | 'grains_bread' | 'pantry_other'
  name                    String
  quantity_grams          Decimal       @db.Decimal(10, 2)
  display_quantity        Float
  display_unit            String
  display_text            String
  is_checked              Boolean       @default(false)
  checked_at              DateTime?
  previous_quantity_grams Decimal?      @db.Decimal(10, 2) // the last amount the user acknowledged, so "was Y" never drifts
  flagged_at              DateTime?
  sort_order              Int
  // Tenant-preserving parent reference, as on meal_plan_days.
  meal_plans              meal_plans    @relation(fields: [meal_plan_id, user_id], references: [id, user_id], onDelete: Cascade, onUpdate: NoAction)
  users                   users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalog_foods           catalog_foods @relation(fields: [catalog_food_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([meal_plan_id, catalog_food_id, food_state])
  @@index([user_id])
}

// The idempotency ledger for every keyed write (generate, regenerate, swap,
// log). A row is RESERVED first and completed by the same transaction, so
// response_status, response_snapshot and plan_revision_after are nullable and
// deliberately carry no defaults: NULL means "reserved but not yet completed",
// and a replay returns the stored status exactly and the stored body as a
// VALUE deep-equal to the first response — jsonb normalises an object's key
// order at rest, so the text can differ while every value is preserved — which
// is why a client cannot tell a replay from the original response and why a
// test of it must compare the parsed body rather than its JSON text. The
// precise statement lives with the code that makes the guarantee, in
// src/services/mealPlanningAction.logic.ts (readStoredResponse).
// request_fingerprint is what distinguishes a genuine retry from a reused key
// with a different body.
model meal_plan_actions {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String
  idempotency_key        String
  action_type            String // 'generate' | 'regenerate' | 'swap' | 'log'
  request_fingerprint    String // SHA-256 of method + action + resource ids + canonical JSON body
  meal_plan_id           String?          @db.Uuid
  meal_plan_meal_id      String?          @db.Uuid
  meal_entry_id          String?          @db.Uuid
  response_status        Int?             @db.SmallInt
  response_snapshot      Json?
  plan_revision_after    Int?
  created_at             DateTime         @default(now())
  users                  users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meal_plans             meal_plans?      @relation("meal_plan_actions_plan", fields: [meal_plan_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  meal_plan_meals        meal_plan_meals? @relation("meal_plan_actions_planned_meal", fields: [meal_plan_meal_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  meal_entries           meal_entries?    @relation("meal_plan_actions_entry", fields: [meal_entry_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  // Tenant guards beside the three SET NULL links above. Each pair must name a
  // row of the SAME user, so a replay can never be answered from, or a created
  // id recorded against, another user's plan, meal or diary entry. The links
  // stay nullable and keep SET NULL: NO ACTION here is checked at end of
  // statement, by which time SET NULL has already cleared the link, and MATCH
  // SIMPLE leaves a NULL link unchecked.
  tenant_meal_plans      meal_plans?      @relation("meal_plan_actions_plan_tenant", fields: [meal_plan_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction)
  tenant_meal_plan_meals meal_plan_meals? @relation("meal_plan_actions_planned_meal_tenant", fields: [meal_plan_meal_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction)
  tenant_meal_entries    meal_entries?    @relation("meal_plan_actions_entry_tenant", fields: [meal_entry_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, idempotency_key])
  @@index([meal_plan_id])
  // The two other SET NULL links need their own leading index: clearing them
  // when a planned meal or diary entry is deleted is a lookup by that column.
  @@index([meal_plan_meal_id])
  @@index([meal_entry_id])
}
